# =============================================================================
# SECRETS AND KEY MATERIAL - never commit any of this
# =============================================================================
# Environment files may hold tokens or passwords. Documentation templates are
# deliberately kept: .env.example must stay committable so setup stays
# discoverable, and it must never contain a real value.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Ed25519 seeds, private keys and portable recovery files. The seed lives in a
# Windows DPAPI envelope outside the repo; a .tcrec is user property and
# belongs on separate offline media (SECURITY.md 6, docs/security-invariants.md).
*.tcrec
*.seed
*.secret
secrets.*
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.keystore
*.jks
*.asc
*.gpg
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
credentials
credentials.*
.netrc
.htpasswd

# =============================================================================
# LOCAL DATA - databases, WAL/journal sidecars, evidence archives
# =============================================================================
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
*-journal
.station-data/

# =============================================================================
# LOGS AND TEMPORARY FILES
# =============================================================================
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
.tmp/
tmp/

# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
.eggs/

# =============================================================================
# NODE / FRONTEND
# =============================================================================
node_modules/
.npm/
.eslintcache
*.tsbuildinfo
.vite/

# =============================================================================
# BUILD OUTPUT
# =============================================================================
dist/
build/
out/
coverage/

# The Windows bundle (ADR-0010 2). Anchored and narrow on purpose: the three
# rules above are unanchored and match at any depth, so accepting
# PyInstaller's default `build/` and `dist/` output names under packaging/
# would have required exempting a source directory from
# tests/security/test_tracked_sources.py - the exemption ADR-0010 3 says
# swallows `packaging/build/helper.py` exactly the way `credentials.*`
# swallowed `credentials.py` in Package G. packaging/build_bundle.py writes
# here instead, and a test asserts it still does.
/packaging/artifacts/

# =============================================================================
# EDITORS / OS
# =============================================================================
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db
desktop.ini
